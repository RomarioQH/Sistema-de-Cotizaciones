# SQL Server RDS; DB_SERVER is the endpoint host, not the database name.
DB_SERVER=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=1433
DB_NAME=db-cotizaciones
DB_USER=app_cotizaciones
DB_PASSWORD=replace-with-a-secret

# Amazon Cognito User Pool SPA app client (must not have a client secret).
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_USER_POOL_CLIENT_ID=exampleclientid

# Angular origin. For local development, use http://localhost:4200.
ALLOWED_ORIGIN=http://localhost:4200

# Optional email sending for POST /cotizaciones/{quoteCode}/enviar.
# Verify this identity in Amazon SES before enabling the route.
SES_FROM_EMAIL=no-reply@example.com
AWS_REGION=us-east-1
